# Environment variables for Vercel Deployment

# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://<user>:<password>@<host>/<dbname>?sslmode=require

# Security
SECRET_KEY=dikhan-health-secret-change-me-in-production-2026
ENVIRONMENT=production
DEBUG=False

# Frontend URL for CORS
FRONTEND_URL=https://dikhan-doctor-appointment.pages.dev

# Email & Notifications (Resend)
RESEND_API_KEY=your_resend_api_key_here
SYSTEM_SENDER_EMAIL=D.I. Khan Healthcare <onboarding@resend.dev>

# Gmail SMTP Notification Credentials
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Cloudinary (Image uploads)
CLOUDINARY_URL=your_cloudinary_url

# AI Chatbot
GEMINI_API_KEY=your_gemini_api_key
