# ========================================================
# D.I. Khan Care — Production Environment Configuration
# ========================================================

# Environment & Debug
ENVIRONMENT=production
DEBUG=False

# Security (Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=replace-with-a-random-64-character-string-in-production

# Database Configuration
# Option A: SQLite (Ensure persistent volume storage)
DATABASE_URL=sqlite+aiosqlite:////app/data/dikhan_care.db

# Option B: Cloud PostgreSQL (e.g. Supabase, Neon, AWS RDS)
# DATABASE_URL=postgresql+asyncpg://postgres:YourPassword@db.supabase.co:5432/postgres

# Redis Distributed Concurrency & Cache (Optional: Falls back to memory cache if absent)
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# CORS Whitelist (Comma-separated list of allowed domains)
CORS_ORIGINS=https://dikhancare.pk,https://www.dikhancare.pk,http://localhost:5173

# Frontend API URL (Leave blank to use same-origin /api/v1)
VITE_API_BASE=

# Email Notifications (Optional: Resend or Direct Gmail SMTP)
RESEND_API_KEY=
SYSTEM_SENDER_EMAIL=D.I. Khan Healthcare <onboarding@resend.dev>
GMAIL_USER=
GMAIL_APP_PASSWORD=
